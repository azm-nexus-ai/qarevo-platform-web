# Qarevo Platform Web - environment variables (server-side unless prefixed NEXT_PUBLIC_).
# This repository is public: never commit real values. Hosted values live in Vercel.

# Platform API base URL. The browser always calls this app's /api/v1 (the BFF),
# which forwards server-side to this URL.
API_BASE_URL=http://localhost:8000
# Legacy fallback for API_BASE_URL; prefer API_BASE_URL.
# NEXT_PUBLIC_API_BASE_URL=

# Shared secret between the BFF and the Platform API (BROWSER_PROXY_SECRET there).
# Server-side only; never a NEXT_PUBLIC_ variable.
BROWSER_PROXY_SECRET=

# Optional host-based portal routing. Leave all unset for shared-host development.
# When used, set all three core portals as HTTPS origins on their canonical
# subdomains (patient., doctor., admin.); the practice portal is optional.
# PORTAL_PATIENT_ORIGIN=https://patient.example.com
# PORTAL_DOCTOR_ORIGIN=https://doctor.example.com
# PORTAL_ADMIN_ORIGIN=https://admin.example.com
# PORTAL_PRACTICE_ORIGIN=https://practice.example.com

# Build provenance shown at /api/health/live. Vercel and CI provide the commit
# automatically (VERCEL_GIT_COMMIT_SHA, GITHUB_SHA); set this only to override.
# QAREVO_BUILD_REVISION=

# Language: no setting. German is the default; the qarevo_locale cookie stores a
# user's choice (ADR-0002).

# End-to-end tests (Playwright)
# E2E_BASE_URL=http://localhost:3000
# E2E_PRODUCTION=1        # test a production build on port 3100
# E2E_EXTERNAL_SERVER=1   # use an already running server
